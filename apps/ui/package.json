{
	"name": "ui",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"generate-openapi-sdk": "oazapfts --optimistic --argumentStyle=object --useEnumType http://localhost:3000/api-json ./src/generated/fetch-client.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@lucide/svelte": "^1.64.0",
		"@oazapfts/runtime": "^1.2.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"dayjs": "^1.11.23",
		"oazapfts": "^7.5.0",
		"svelte-time": "^2.3.1",
		"sveltekit-i18n": "^3.4.1"
	}
}
